[global_config]
  title_transmit_bg_color = "#394149"
  title_receive_bg_color = "#2c2c2c"
  title_inactive_bg_color = "#202020"
  title_hide_sizetext = True
  window_state = maximise
  suppress_multiple_term_dialog = True
  always_split_with_profile = True
[keybindings]
  close_window = None
  toggle_scrollbar = <Ctrl><Shift>s
[profiles]
  [[default]]
    background_color = "#1e1e1e"
    background_darkness = 0.88
    background_type = transparent
    cursor_color = "#aaaaaa"
    cursor_color_fg = False
    cursor_blink = True
    cursor_shape = ibeam
    font = JetBrains Mono NL 11
    foreground_color = "#cccccc"
    show_titlebar = False
    scrollbar_position = hidden
    use_system_font = False
    copy_on_selection = True
    word_chars = "-A-Za-z0-9,./?%&#:_"
    palette = "#000000:#cd3131:#0dbc79:#e5e510:#2472c8:#bc3fbc:#11a8cd:#e5e5e5:#666666:#f14c4c:#23d18b:#f5f543:#3b8eea:#d670d6:#29b8db:#e5e5e5"
    login_shell = True
[layouts]
  [[default]]
    [[[window0]]]
      type = Window
      parent = ""
      size = 1920, 1080
    [[[child1]]]
      type = Terminal
      parent = window0
      profile = default
[plugins]
